#!/usr/bin/env bash
# Removes exactly what .forge/seed created.
here=$(cd "$(dirname "$0")" && pwd)
[[ -f $here/demo-root ]] || exit 0
demo=$(<"$here/demo-root")
if [[ $demo == /tmp/agents-waiting-demo-* && -d $demo ]]; then
  [[ -f $demo/pids ]] && kill $(<"$demo/pids") 2>/dev/null
  rm -rf "$demo"
fi
rm -f "$here/demo-root"
